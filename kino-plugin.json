{
  "id": "zapptv",
  "name": "ZappTV",
  "version": "0.3.10",
  "apiVersion": 6,
  "entry": "plugin.js",
  "icon": "icon.png",
  "description": "Catálogo y streaming de ZappTV (películas, series y TV en vivo).",
  "categories": [
    "movies",
    "series",
    "live"
  ],
  "hosts": [
    {
      "host": "api.myzapptv.com",
      "insecureHttp": true
    },
    {
      "host": "api.zapptv.co",
      "insecureHttp": true
    },
    {
      "host": "api.zapptv.fun",
      "insecureHttp": true
    },
    {
      "host": "image.myzapptv.com",
      "insecureHttp": true
    },
    {
      "host": "cdn.myzapptv.com",
      "insecureHttp": true
    },
    {
      "host": "gb.myzapptv.com",
      "insecureHttp": true
    },
    {
      "host": "gb.aiphotoalbum1.com",
      "insecureHttp": true
    }
  ],
  "streamHosts": "any",
  "capabilities": [
    "search",
    "home",
    "browse",
    "episodes",
    "resolve"
  ],
  "secrets": {
    "aesKey": {
      "seal": "kino-sealed:v1:WLJX2chm2mN-Rw2tS_ThXMUL3tr61YHms08jSvNd6Q6NczL9F360tG68_VqjnyN-bcfjEL5XShDByjn7pXiV7qOfEhfV5Jjk4IAfn8v9V6zvuF10jSpl7OzExbY",
      "use": "cipher-key",
      "encoding": "hex"
    }
  },
  "settings": [
    {
      "key": "status",
      "label": "Estado de conexión",
      "labelEn": "Connection status",
      "type": "status"
    }
  ],
  "enhancements": {
    "14": {
      "capabilities": [
        "screen"
      ],
      "screen": {
        "label": "ZappTV",
        "labelEn": "ZappTV",
        "icon": "movie",
        "menuOpens": "screen",
        "opensFrom": [
          "menu",
          "settings"
        ],
        "settingsButton": {
          "label": "Abrir ZappTV",
          "labelEn": "Open ZappTV"
        }
      }
    },
    "19": {
      "capabilities": [
        "screen"
      ]
    },
    "20": {
      "provides": {
        "catalog": {
          "summary": "Titles this plugin finds, for the author's other plugins",
          "calls": {
            "search": {
              "in": {
                "q": "string",
                "type": "string?"
              },
              "out": "Item[]"
            }
          },
          "types": {
            "Item": {
              "id": "string",
              "ref": "string",
              "title": "string",
              "kind": "string",
              "poster": "string?",
              "backdrop": "string?",
              "year": "string?",
              "overview": "string?",
              "tmdb": "number?"
            }
          }
        }
      }
    }
  },
  "signature": {
